  "questions": [
    {
      "examType": "BUET Admission Hard",
      "question": "100 পাকের কুন্ডলীতে 0.02 s এ ফ্লাক্স 0.05 Wb হতে কমে 0.01 Wb হলে আবিষ্ট e.m.f. কত?",
      "answer": "\\mathcal{E} = -100 \\frac{0.01 - 0.05}{0.02} = 100 \\times \\frac{0.04}{0.02} = 200\\text{ V}"
