    "steps": [
      {
        "title": "ফ্লাক্স পরিবর্তন হার",
        "latex": "\\mathcal{E} = -N \\frac{\\Delta \\Phi_B}{\\Delta t} = -N A \\frac{dB}{dt}",
        "note": "স্থির ক্ষেত্রফলে dΦ = A dB"
