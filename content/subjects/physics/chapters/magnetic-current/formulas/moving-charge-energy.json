    "steps": [
      {
        "title": "মূল সূত্র",
        "latex": "E_k = \\frac{1}{2} m v^2 = \\frac{q^2 B^2 r^2}{2m}",
        "note": "গতিশীল আধানের গতিশক্তি এর প্রাথমিক রূপ।"
      },
      {
        "title": "মনে রাখা ও প্রয়োগ",
        "latex": "E_k = \\frac{1}{2} m v^2 = \\frac{q^2 B^2 r^2}{2m}",
        "note": "E = q²B²r²/(2m) — r = mv/(qB) থেকে v বের করে ½mv²-এ বসালেই আসে। উপরে সব বর্গ (q², B², r²), নিচে 2m।"
      }
    ],
    "assumptions": [
      "কণাটির বেগ অ-আপেক্ষিক (Non-relativistic v << c)।"
    ]
  },
  "questions": [
    {
      "examType": "BUET / CKRU (Hard)",
      "question": "একটি ডিউটেরন (m = 3.34 × 10⁻²⁷ kg, q = 1.6 × 10⁻¹⁹ C) 0.5 m ব্যাসার্ধের বৃত্তাকার পথে 1.2 T চৌম্বক ক্ষেত্রে ঘুরলে এর সর্বোচ্চ গতিশক্তি কত MeV হবে?",
      "answer": "E_k = \\frac{(1.6 \\times 10^{-19})^2 \\times (1.2)^2 \\times (0.5)^2}{2 \\times 3.34 \\times 10^{-27}} = 1.381 \\times 10^{-12} \\text{ J} = \\frac{1.381 \\times 10^{-12}}{1.6 \\times 10^{-13}} = 8.63 \\text{ MeV}"
    }
  ],
  "memorize": {
    "trick": "E = q²B²r²/(2m) — r = mv/(qB) থেকে v বের করে ½mv²-এ বসালেই আসে। উপরে সব বর্গ (q², B², r²), নিচে 2m।",
    "steps": [
      "r = mv/(qB) থেকে v = qBr/m।",
      "E = ½mv² = ½m·(qBr/m)² = q²B²r²/(2m)।"
    ]
  }
