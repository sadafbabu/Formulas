  "derivation": {
    "lead": "ক্রস গুণনের মান গুণফলের উচ্চতা নির্দেশ করে যা ক্ষেত্রফলের সমান।",
    "steps": [
      {
        "title": "ক্ষেত্রফল সম্পর্ক",
        "latex": "\\text{Base} = |\\mathbf{A}|, \\quad \\text{Height} = |\\mathbf{B}| \\sin\\theta \\implies \\text{Area} = |\\mathbf{A}| |\\mathbf{B}| \\sin\\theta = |\\mathbf{A} \\times \\mathbf{B}|",
        "note": "কর্ণদ্বয় দেওয়া থাকলে ক্ষেত্রফল = 1/2 |d1 × d2|"
      }
    ],
    "assumptions": [
      "HSC/ভর্তি পর্যায়ে প্রচলিত আদর্শ শর্ত প্রযোজ্য"
    ]
  },
  "questions": [
    {
      "examType": "BUET Admission Hard",
      "question": "A = 2i + j - k এবং B = i - j + 2k বাহু দুটি দ্বারা গঠিত সামান্তরিকের ক্ষেত্রফল কত?",
      "answer": "\\mathbf{A} \\times \\mathbf{B} = \\begin{vmatrix} \\hat{i} & \\hat{j} & \\hat{k} \\\\ 2 & 1 & -1 \\\\ 1 & -1 & 2 \\end{vmatrix} = \\hat{i}(2-1) - \\hat{j}(4+1) + \\hat{k}(-2-1) = \\hat{i} - 5\\hat{j} - 3\\hat{k} \\implies \\text{Area} = \\sqrt{1^2 + (-5)^2 + (-3)^2} = \\sqrt{35} \\approx 5.916"
    }
  ],
  "memorize": {
    "trick": "|A×B| = AB sinθ = সামান্তরিকের ক্ষেত্রফল; ত্রিভুজের জন্য অর্ধেক। দিক ডান হাতের নিয়মে, তাই A×B = −(B×A) — ক্রমে ক্রস উল্টালে চিহ্ন বদলায়।",
    "steps": [
      "সামান্তরিকের ক্ষেত্রফল = |A×B|; ত্রিভুজের = ½|A×B|।",
      "সমান্তরাল ভেক্টরে A×B = 0 (sin0 = 0) — সমরেখতা যাচাইয়ের উপায়।",
      "প্রয়োগ: টর্ক τ = r×F, কৌণিক ভরবেগ L = r×p।"
    ]
  },
