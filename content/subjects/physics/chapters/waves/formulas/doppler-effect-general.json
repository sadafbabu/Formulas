  },
  "questions": [
    {
      "examType": "HSC",
      "question": "উৎস 340 Hz, v=340 m/s, v_s=20 m/s কাছে আসছে। f′?",
      "answer": "f'=340\\cdot\\dfrac{340}{340-20}=340\\cdot\\dfrac{340}{320}=361.25\\mathrm{Hz}"
    }
