  "derivation": {
    "lead": "পর্যবেক্ষক কাছে → লবতে +; উৎস কাছে → হরে − (তরঙ্গদৈর্ঘ্য কমে)।",
    "steps": [
      {
        "title": "সাধারণ সূত্র",
        "latex": "f'=f\\,\\dfrac{v\\pm v_o}{v\\pm v_s}",
        "note": "চিহ্ন: কাছে আসা = কম্পাঙ্ক বাড়ে।"
      },
      {
        "title": "উদাহরণ — উৎস কাছে",
        "latex": "f'=f\\dfrac{v}{v-v_s}",
        "note": "পর্যবেক্ষক স্থির।"
      }
    ],
    "assumptions": [
      "নিশ্চল মাধ্যম; v_s < v; শব্দ/যান্ত্রিক তরঙ্গ"
