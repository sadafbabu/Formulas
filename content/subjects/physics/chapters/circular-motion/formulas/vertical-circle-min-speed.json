  "derivation": {
    "lead": "উপরে N+mg = mv²/R; N≥0 → v²≥gR। শক্তি সংরক্ষণে নিচের বেগ।",
    "steps": [
      {
        "title": "উপর",
        "latex": "v_t=\\sqrt{gR}",
        "note": "ঠিক সীমায় N=0।"
      },
      {
        "title": "নিচ",
        "latex": "\\tfrac12mv_b^2=\\tfrac12mv_t^2+mg(2R)\\Rightarrow v_b=\\sqrt{5gR}",
        "note": "উচ্চতা পার্থক্য 2R।"
      }
    ],
    "assumptions": [
      "দড়ি/ট্র্যাক; ঘর্ষণহীন; কণা মডেল"
    ]
  },
