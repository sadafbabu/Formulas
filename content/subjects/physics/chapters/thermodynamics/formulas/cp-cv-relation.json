  "questions": [
    {
      "examType": "BUET Admission Hard",
      "question": "একটি দ্বিপারমাণবিক গ্যাসের জন্য γ = 1.40 হলে C_v এর মান কত? [R = 8.314 J/mol·K]",
      "answer": "C_v = \\frac{R}{\\gamma - 1} = \\frac{8.314}{1.40 - 1} = \\frac{8.314}{0.4} = 20.785\\text{ J/(mol·K)}"
