  "derivation": {
    "lead": "স্থির চাপ ও স্থির আয়তনে ১ম তাপগতীয় সূত্রের তুলনা থেকে পাওয়া যায়।",
    "steps": [
      {
        "title": "মেয়ারের সম্পর্ক রূপায়ণ",
        "latex": "dQ_p - dQ_v = P dV = n R dT \\implies C_p - C_v = R",
        "note": "দ্বিপারমাণবিক গ্যাসের জন্য γ = 1.40"
      }
