  "memorize": {
    "trick": "একই প্রবাহে জমা ভরের অনুপাত = তুল্য ভরের অনুপাত: m₁/m₂ = E₁/E₂, যেখানে E = M/n। 'সমান তড়িৎ, ভাগাভাগি তুল্য ভর অনুযায়ী'।",
    "steps": [
      "তুল্য ভর E = আণবিক ভর/যোজনী পরিবর্তন (n)।",
      "শ্রেণীতে জোড়া কোষে প্রবাহ একই, তাই ভর কেবল E-এর উপর নির্ভর করে।",
      "প্রথম সূত্রের সাথে মিলিয়ে m = (E·I·t)/96500।"
    ]
