    "lead": "দুর্বল অ্যাসিড–তার লবণের বাফারে Henderson–Hasselbalch ব্যবহার হয়।",
    "steps": [
      {
        "title": "Ka থেকে",
        "latex": "K_a=\\dfrac{[\\mathrm{H^+}][\\mathrm{A^-}]}{[\\mathrm{HA}]}",
        "note": "লগ নিয়ে সাজাও।"
      },
      {
        "title": "HH সমীকরণ",
        "latex": "\\mathrm{pH}=\\mathrm{p}K_a+\\log\\dfrac{[\\mathrm{A^-}]}{[\\mathrm{HA}]}",
        "note": "অল্প অ্যাসিড/ক্ষার যোগে অনুপাত প্রায় স্থির → pH স্থির।"
      }
    ],
    "assumptions": [
      "তনু বাফার; কার্যকলাপ ≈ ঘনমাত্রা"
    ]
  },
