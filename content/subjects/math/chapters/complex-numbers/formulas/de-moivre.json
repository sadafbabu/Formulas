  "derivation": {
    "lead": "z = r(cosθ + i sinθ) মেরু রূপ। এটি Euler সূত্র e^(iθ) = cosθ + i sinθ থেকে প্রাপ্ত।",
    "steps": [
      {
        "title": "n-তম মূল নির্ণয়",
        "latex": "z^{1/n} = r^{1/n}\\left[\\cos\\frac{\\theta + 2k\\pi}{n} + i\\sin\\frac{\\theta + 2k\\pi}{n}\\right], \\quad k = 0, 1, 2, \\ldots, n-1",
        "note": "1 এর n-তম মূল: ω = e^(2πi/n), ω^n = 1"
      }
    ]
  },
