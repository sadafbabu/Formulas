  "memorize": {
    "trick": "নতুন root y = পুরনো x + h হলে equation-এ x = y − h বসে—চিহ্ন উল্টো। Reciprocal roots চাইলে coefficients reverse হয়।",
    "steps": [
      "α+h ⇒ f(y−h)=0।",
      "kα ⇒ f(y/k)=0।",
