  "derivation": {
    "lead": "নতুন চলক y ও পুরনো root x-এর সম্পর্ক উল্টে x-এর জায়গায় বসালেই নতুন equation।",
    "steps": [
      {
        "title": "মূল α+h",
        "latex": "y=x+h\\Rightarrow x=y-h\\Rightarrow f(y-h)=0",
        "note": "চিহ্ন উল্টো বসে—এটাই সাধারণ ভুল।"
      },
      {
        "title": "মূল kα",
        "latex": "y=kx\\Rightarrow x=y/k\\Rightarrow f(y/k)=0",
        "note": "Fraction দূর করতে প্রয়োজনমতো kⁿ দিয়ে গুণ।"
      },
      {
        "title": "reciprocal roots",
        "latex": "y=1/x\\Rightarrow y^nf(1/y)=0",
        "note": "Coefficient order উল্টে যায়।"
      }
    ],
    "assumptions": [
      "শূন্য root থাকলে reciprocal transformation সংজ্ঞায়িত নয়।"
    ]
  },
  "questions": [
