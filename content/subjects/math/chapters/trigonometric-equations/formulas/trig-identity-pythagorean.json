  "questions": [
    {
      "examType": "HSC Board",
      "question": "যদি sin θ = 3/5 হয়, তবে cos θ ও tan θ এর মান কত? [θ দ্বিতীয় চতুর্থাংশে নয়]",
      "answer": "\\cos\\theta = \\sqrt{1 - \\sin^2\\theta} = \\sqrt{1 - \\frac{9}{25}} = \\frac{4}{5}, \\quad \\tan\\theta = \\frac{\\sin\\theta}{\\cos\\theta} = \\frac{3}{4}"
    }
