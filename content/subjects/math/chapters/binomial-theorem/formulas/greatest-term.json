  "questions": [
    {
      "examType": "HSC",
      "question": "(a+b)^n এ বৃহত্তম পদ নির্ণয়ের শর্ত কী?",
      "answer": "T_{r+1}/T_r \\ge 1 \\Rightarrow r \\le \\frac{(n+1)b}{a+b}"
    }
