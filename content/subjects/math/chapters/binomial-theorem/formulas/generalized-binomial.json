  "derivation": {
    "lead": "Taylor series-এ f(x)=(1+x)^n বসালে successive derivative থেকে coefficient আসে।",
    "steps": [
      {
        "title": "general coefficient",
        "latex": "T_{r+1}=\\frac{n(n-1)\\cdots(n-r+1)}{r!}x^r",
        "note": "n nonnegative integer না হলে series অসীম।"
      },
      {
        "title": "negative index",
        "latex": "(1+x)^{-1}=1-x+x^2-x^3+\\cdots",
        "note": "Geometric series-এর সাথে মিলে; |x|<1 আবশ্যক।"
      },
      {
        "title": "half index",
        "latex": "\\sqrt{1+x}=1+\\frac x2-\\frac{x^2}{8}+\\frac{x^3}{16}-\\cdots",
        "note": "ছোট x-এ approximation-এ ব্যবহৃত।"
      }
    ],
    "assumptions": [
      "অসীম series-এর convergence-এর জন্য |x|<1।"
    ]
  },
  "questions": [
    {
      "examType": "Varsity Admission",
      "question": "(1+x)^{-2}-এর প্রথম চারটি পদ লিখুন।",
      "answer": "1-2x+3x^2-4x^3+\\cdots"
    }
  ],
  "memorize": {
    "trick": "Positive integer n হলে finite; negative/fractional n হলে infinite এবং |x|<1 আবশ্যক। Coefficient-এ n থেকে এক এক করে কমিয়ে r! দিয়ে ভাগ।",
    "steps": [
      "(1+x)⁻¹ = 1−x+x²−x³… pattern base হিসেবে মনে রাখুন।",
      "Convergence condition না লিখলে উত্তর অসম্পূর্ণ।"
    ]
  }
